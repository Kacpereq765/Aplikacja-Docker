@page "/Weather"
@rendermode InteractiveServer

@using BlazorApp2.Data
@using BlazorApp2.Models
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db

<PageTitle>To Do List</PageTitle>

<h1>To Do List</h1>

<div class="mb-3">
    <input class="form-control"
           placeholder="Dodaj zadanie"
           @bind="newTask" />
</div>

<button class="btn btn-primary mb-3" @onclick="AddTask">
    Dodaj
</button>

@if (tasks == null)
{
    <p>Ładowanie...</p>
}
else if (!tasks.Any())
{
    <p>Brak zadań</p>
}
else
{
    <ul class="list-group">
        @foreach (var task in tasks)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <span style="text-decoration:@(task.IsDone ? "line-through" : "none")">
                    @task.Title
                </span>

                <div>
                    <button class="btn btn-success btn-sm me-2"
                            @onclick="() => Toggle(task)">
                        ✔
                    </button>

                    <button class="btn btn-danger btn-sm"
                            @onclick="() => RemoveTask(task)">
                        Usuń
                    </button>
                </div>
            </li>
        }
    </ul>
}

@code {
    private List<TodoItem> tasks = new();
    private string newTask = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadTasks();
    }

    private async Task LoadTasks()
    {
        tasks = await Db.Todos
            .OrderBy(x => x.Id)
            .ToListAsync();
    }

    private async Task AddTask()
    {
        if (string.IsNullOrWhiteSpace(newTask))
            return;

        Db.Todos.Add(new TodoItem
        {
            Title = newTask,
            IsDone = false
        });

        await Db.SaveChangesAsync();

        newTask = "";
        await LoadTasks();
    }

    private async Task RemoveTask(TodoItem task)
    {
        Db.Todos.Remove(task);
        await Db.SaveChangesAsync();
        await LoadTasks();
    }

    private async Task Toggle(TodoItem task)
    {
        task.IsDone = !task.IsDone;
        await Db.SaveChangesAsync();
        await LoadTasks();
    }
}

