@page "/"
@rendermode InteractiveServer

<h1>Konwerter temperatury</h1>

<div class="mb-3">
    <label>Celsjusz:</label>
    <input type="text" class="form-control" @bind="CelsiusInput" />
</div>

<div class="mb-3">
    <label>Fahrenheit:</label>
    <input type="text" class="form-control" @bind="FahrenheitInput" />
</div>

<button class="btn btn-primary me-2" @onclick="ConvertCtoF">Przelicz C → F</button>
<button class="btn btn-secondary" @onclick="ConvertFtoC">Przelicz F → C</button>

<p>@Message</p>

@code {
    private string CelsiusInput = "0";
    private string FahrenheitInput = "32";

    private string Message => $"Temperatura: {CelsiusInput}°C = {FahrenheitInput}°F";

    private void ConvertCtoF()
    {
        if (double.TryParse(CelsiusInput, out double c))
        {
            double f = c * 9 / 5 + 32;
            FahrenheitInput = f.ToString("F2");
        }
    }

    private void ConvertFtoC()
    {
        if (double.TryParse(FahrenheitInput, out double f))
        {
            double c = (f - 32) * 5 / 9;
            CelsiusInput = c.ToString("F2");
        }
    }
}

